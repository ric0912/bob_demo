# Database Configuration
# For MySQL (default):
DATABASE_URL=mysql+pymysql://fleetuser:fleetpass@localhost:3306/fleet_management
# For SQLite (demo mode without external database):
# DATABASE_URL=sqlite:///./fleet_management.db

DB_HOST=localhost
DB_PORT=3306
DB_NAME=fleet_management
DB_USER=fleetuser
DB_PASSWORD=fleetpass

# SQLite Mode (for demo without external database)
# Set USE_SQLITE=true to use in-memory SQLite instead of MySQL
USE_SQLITE=false
# Set GENERATE_DUMMY_DATA=true to auto-generate dummy data on startup
GENERATE_DUMMY_DATA=false

# Application Settings
APP_NAME=Fleet Management Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Event Queue
EVENT_QUEUE_MAX_SIZE=1000
EVENT_PROCESSING_INTERVAL=0.1

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# IBM Cloud (Production)
IBM_CLOUD_API_KEY=
IBM_CLOUD_REGION=us-south